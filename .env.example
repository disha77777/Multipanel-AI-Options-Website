# Required for AI generation in Multipanel and the chemistry API
GEMINI_API_KEY=your_gemini_api_key

# Optional alternative provider for presentations, plans, cleaning, and OCR.
XAI_API_KEY=your_xai_api_key
# Optional model override; defaults to the current xAI chat model.
# Defaults to grok-4.20-0309-non-reasoning for lower latency.
# XAI_MODEL=grok-4.20-0309-non-reasoning

# API hardening. Set ALLOWED_ORIGINS to the exact browser origin(s) that may call
# the chemistry API, separated by commas. Leave empty for same-origin only.
ALLOWED_ORIGINS=
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
MAX_QUESTION_LENGTH=4000
TRUST_PROXY_HEADERS=false

# Optional release controls
ENABLE_CHEMISTRY=true
ENABLE_LIVE_RESEARCH=true
